# Normalise line endings: LF in the repository, native on checkout.
* text=auto

# Verilog / Tcl / Python / Markdown — always LF
*.v     text
*.sv    text
*.tcl   text
*.py    text
*.md    text

# The batch runner must keep CRLF or cmd.exe will choke on it
*.bat   text eol=crlf

# Binary — never touch
*.png   binary
*.vcd   binary
*.pdf   binary
